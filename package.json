{
  "name": "kuvi-api",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run build && node --test tests/smoke.test.mjs tests/access.test.mjs tests/auth-limits.test.mjs",
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc",
    "start": "node dist/app/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node ops/db-command.mjs migrate-deploy",
    "prisma:studio": "prisma studio",
    "seed": "node ops/db-command.mjs seed",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:documents": "node ops/db-tests.mjs documents",
    "test:medications": "node ops/db-tests.mjs medications",
    "test:appointments": "node ops/db-tests.mjs appointments",
    "test:physicians": "node ops/db-tests.mjs physicians",
    "test:sessions": "node ops/db-tests.mjs sessions",
    "test:clinical-access": "node ops/db-tests.mjs clinical-access",
    "doctor:onboard": "node ops/db-command.mjs doctor-onboard",
    "report:physicians": "node dist/modules/physicians/report.js",
    "db:migrate:deploy": "node ops/db-command.mjs migrate-deploy",
    "db:migrate:status": "node ops/db-command.mjs migrate-status",
    "test:backups": "node --test tests/backup.test.mjs",
    "test:db-permissions": "node tests/run-database-permissions.mjs",
    "db:permissions:audit": "node ops/database-bootstrap.mjs audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelperezdelvalle/kuvi-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/miguelperezdelvalle/kuvi-api/issues"
  },
  "homepage": "https://github.com/miguelperezdelvalle/kuvi-api#readme",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "10.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cheerio": "1.1.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "description": "",
  "type": "module"
}
